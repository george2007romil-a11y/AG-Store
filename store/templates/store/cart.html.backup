{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart | A.G Store</title>
    <link rel="stylesheet" href="{% static 'store/style.css' %}">
    <style>
        .cart-page{max-width:1000px;margin:35px auto;padding:0 16px;color:#171717}
        .cart-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:24px}
        .cart-heading h2{margin:0;font-size:28px}
        .cart-heading p{margin:7px 0 0;color:#666}
        .cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:22px;align-items:start}
        .cart-list,.cart-summary{background:#fff;border:1px solid #e8e3ef;border-radius:18px;padding:18px}
        .cart-item{display:grid;grid-template-columns:105px minmax(0,1fr);gap:16px;padding:16px 0;border-bottom:1px solid #eee}
        .cart-item:first-child{padding-top:0}
        .cart-item:last-child{border-bottom:0;padding-bottom:0}
        .cart-item img{width:105px;height:110px;object-fit:contain;background:#f7f5fb;border-radius:12px}
        .cart-item h3{margin:2px 0 8px;font-size:17px;overflow-wrap:anywhere}
        .cart-price{margin:5px 0;color:#555;font-size:14px}
        .cart-subtotal{margin:7px 0;font-weight:700;color:#6D28D9}
        .quantity-control{display:flex;align-items:center;gap:12px;margin:12px 0}
        .quantity-control form{margin:0}
        .quantity-btn{width:34px;height:34px;border:1px solid #ddd;border-radius:9px;background:#fff;color:#6D28D9;font-size:20px;cursor:pointer}
        .quantity-number{font-weight:700;min-width:16px;text-align:center}
        .remove-btn{border:0;background:none;color:#6D28D9;text-decoration:underline;padding:5px 0;cursor:pointer}
        .cart-summary h3{margin:0 0 18px;font-size:19px}
        .summary-line{display:flex;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid #eee}
        .summary-total{font-size:20px;font-weight:800;color:#6D28D9;border:0}
        .cart-action{display:block;text-align:center;text-decoration:none;border-radius:10px;padding:13px 12px;margin-top:12px;font-weight:700}
        .checkout-action{background:#6D28D9;color:white}
        .continue-action{border:1px solid #6D28D9;color:#6D28D9;background:white}
        .empty-cart{text-align:center;padding:35px 12px}
        .empty-cart .empty-icon{font-size:42px;color:#6D28D9}
        .empty-cart h3{font-size:22px;margin:12px 0 8px}
        .empty-cart p{color:#666}
        @media(max-width:700px){.cart-layout{grid-template-columns:1fr}.cart-heading h2{font-size:24px}.cart-list,.cart-summary{padding:14px}.cart-item{grid-template-columns:85px minmax(0,1fr);gap:12px}.cart-item img{width:85px;height:95px}.cart-item h3{font-size:15px}.cart-summary{order:2}}
    </style>
</head>
<body>
<header>
    <h1>A.G Store</h1>
    <p>Find your frame. Define your look.</p>
    <a href="{% url 'cart' %}" class="cart-link">🛒 Cart ({{ cart_count }})</a>
</header>

<main class="cart-page">
    <div class="cart-heading">
        <div>
            <h2>Your Shopping Cart</h2>
            <p>Review your items before checkout.</p>
        </div>
        <a href="{% url 'home' %}" class="continue-action cart-action">Continue Shopping</a>
    </div>

    {% if cart_items %}
    <div class="cart-layout">
        <section class="cart-list">
            {% for item in cart_items %}
            <article class="cart-item">
                {% if item.product.image %}
                    <img src="{{ item.product.image.url }}" alt="{{ item.product.name }}">
                {% else %}
                    <div class="image-placeholder">A.G</div>
                {% endif %}
                <div>
                    <h3>{{ item.product.name }}</h3>
                    <p class="cart-price">Unit price: {{ item.product.price }} EGP</p>
                    <div class="quantity-control">
                        <form method="post" action="{% url 'update_cart' item.product.id 'decrease' %}">
                            {% csrf_token %}
                            <button type="submit" class="quantity-btn" aria-label="Decrease quantity">−</button>
                        </form>
                        <span class="quantity-number">{{ item.quantity }}</span>
                        <form method="post" action="{% url 'update_cart' item.product.id 'increase' %}">
                            {% csrf_token %}
                            <button type="submit" class="quantity-btn" aria-label="Increase quantity">+</button>
                        </form>
                    </div>
                    <p class="cart-subtotal">Subtotal: {{ item.subtotal }} EGP</p>
                    <form method="post" action="{% url 'remove_from_cart' item.product.id %}">
                        {% csrf_token %}
                        <button type="submit" class="remove-btn">Remove item</button>
                    </form>
                </div>
            </article>
            {% endfor %}
        </section>

        <aside class="cart-summary">
            <h3>Order Summary</h3>
            <div class="summary-line"><span>Items</span><span>{{ cart_count }}</span></div>
            <div class="summary-line summary-total"><span>Total</span><span>{{ total }} EGP</span></div>
            <p class="cart-price">Shipping fees, if applicable, are confirmed at checkout.</p>
            <a href="{% url 'checkout' %}" class="cart-action checkout-action">Proceed to Checkout</a>
            <a href="{% url 'home' %}" class="cart-action continue-action">Continue Shopping</a>
        </aside>
    </div>
    {% else %}
    <section class="cart-list empty-cart">
        <div class="empty-icon">🛒</div>
        <h3>Your cart is empty</h3>
        <p>You haven't added any products yet.</p>
        <a href="{% url 'home' %}" class="cart-action checkout-action">Explore Products</a>
    </section>
    {% endif %}
</main>
</body>
</html>
